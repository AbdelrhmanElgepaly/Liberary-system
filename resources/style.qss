/* ============================================================
   Library Manager - Qt Style Sheet
   Palette: warm "old library" browns + amber accent on paper-white content.
   ============================================================ */

* {
    color: #2A211A;
    selection-background-color: #F6D9A8;
    selection-color: #2A211A;
}

QMainWindow, QDialog, #pages, QStackedWidget {
    background: #F4EFE7;
}

QToolTip {
    background: #2A211A;
    color: #FFFFFF;
    border: none;
    padding: 6px 8px;
}

/* ---------------------------------------------------------------- sidebar */
#sidebar {
    background: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1E1610, stop:1 #120C08);
    border: none;
}
#sidebar QLabel { color: #FFFFFF; background: transparent; }
#brandName { font-size: 13pt; font-weight: 700; color: #FFFFFF; }
#brandSub  { font-size: 9pt; font-weight: 600; letter-spacing: 2px; color: #E3A64B; }
#navSection { font-size: 8pt; font-weight: 700; letter-spacing: 2px; color: #8F7E6C; padding-left: 8px; }

#navButton {
    text-align: left;
    padding: 0 14px;
    border: none;
    border-radius: 10px;
    background: transparent;
    color: #D9CDBE;
    font-size: 10.5pt;
    font-weight: 600;
}
#navButton:hover { background: rgba(255, 255, 255, 0.07); color: #FFFFFF; }
#navButton:checked { background: rgba(227, 166, 75, 0.20); color: #FFFFFF; }

#userBox { background: rgba(255, 255, 255, 0.06); border-radius: 12px; }
#avatar { background: #E3A64B; color: #2A1A06; border-radius: 18px; font-weight: 800; font-size: 12pt; }
#userName { font-size: 10pt; font-weight: 700; color: #FFFFFF; }
#userRole { font-size: 8.5pt; color: #A89888; }

#logoutButton {
    text-align: left;
    padding: 0 14px;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 10px;
    background: transparent;
    color: #E9DECF;
    font-weight: 600;
}
#logoutButton:hover { background: rgba(214, 69, 61, 0.28); border-color: rgba(214, 69, 61, 0.6); }

/* ------------------------------------------------------------ typography */
#pageTitle    { font-size: 22pt; font-weight: 800; color: #2A211A; }
#pageSubtitle { font-size: 10.5pt; color: #7B6E62; }
#cardTitle    { font-size: 13pt; font-weight: 700; color: #2A211A; }
#mutedLabel   { font-size: 9.5pt; color: #7B6E62; }
#fieldLabel   { font-size: 9.5pt; font-weight: 700; color: #4A3D31; padding-top: 4px; }
#dialogTitle    { font-size: 16pt; font-weight: 800; }
#dialogSubtitle { font-size: 10pt; color: #7B6E62; }
#loginTitle   { font-size: 24pt; font-weight: 800; }
#statValue    { font-size: 22pt; font-weight: 800; }
#statCaption  { font-size: 9.5pt; color: #7B6E62; font-weight: 600; }
#emptyState   { font-size: 11pt; color: #2E8B57; font-weight: 600; padding: 28px; }

#errorLabel {
    color: #A93226;
    background: #FDECEA;
    border: 1px solid #F5C6C0;
    border-radius: 8px;
    padding: 8px 10px;
    font-weight: 600;
}
#infoBox {
    background: #FBF3E4;
    border: 1px solid #F1DDB4;
    border-radius: 10px;
    padding: 10px 12px;
    color: #6B4A12;
    font-weight: 600;
}
#card QLabel#cardIcon { background: #B06A10; border-radius: 11px; }

/* ----------------------------------------------------------------- cards */
#card {
    background: #FFFFFF;
    border: 1px solid #ECE3D6;
    border-radius: 16px;
}
#card QLabel { background: transparent; }
#loginForm { background: #FFFFFF; }
#loginForm QLabel { background: transparent; }

/* --------------------------------------------------------------- buttons */
QPushButton {
    background: #FFFFFF;
    border: 1px solid #DCCFBF;
    border-radius: 10px;
    padding: 9px 16px;
    font-weight: 600;
    color: #4A3D31;
}
QPushButton:hover    { background: #F8F2E9; border-color: #CDBBA3; }
QPushButton:pressed  { background: #F0E7DA; }
QPushButton:disabled { color: #B5A998; background: #F7F3ED; border-color: #E8DFD2; }

QPushButton[kind="primary"] {
    background: #B06A10;
    border: 1px solid #B06A10;
    color: #FFFFFF;
}
QPushButton[kind="primary"]:hover    { background: #965A0B; border-color: #965A0B; }
QPushButton[kind="primary"]:pressed  { background: #7F4B08; }
QPushButton[kind="primary"]:disabled { background: #DDBE90; border-color: #DDBE90; color: #FFFFFF; }

QPushButton[kind="danger"] {
    background: #C0392B;
    border: 1px solid #C0392B;
    color: #FFFFFF;
}
QPushButton[kind="danger"]:hover    { background: #A93226; border-color: #A93226; }
QPushButton[kind="danger"]:pressed  { background: #922B21; }
QPushButton[kind="danger"]:disabled { background: #E6B5AF; border-color: #E6B5AF; color: #FFFFFF; }

/* segmented control (reports) */
QPushButton[segment] {
    border-radius: 0px;
    padding: 9px 20px;
    background: #FFFFFF;
    border: 1px solid #DCCFBF;
}
QPushButton[segment="first"] { border-top-left-radius: 10px; border-bottom-left-radius: 10px; }
QPushButton[segment="last"]  { border-top-right-radius: 10px; border-bottom-right-radius: 10px; }
QPushButton[segment="middle"] { border-left: none; }
QPushButton[segment="last"]   { border-left: none; }
QPushButton[segment]:checked { background: #2A211A; border-color: #2A211A; color: #FFFFFF; }

/* ---------------------------------------------------------------- inputs */
QLineEdit, QComboBox, QSpinBox {
    background: #FFFFFF;
    border: 1px solid #DCCFBF;
    border-radius: 10px;
    padding: 8px 12px;
    min-height: 20px;
}
QLineEdit:focus, QComboBox:focus, QSpinBox:focus { border: 1.5px solid #B06A10; }
QLineEdit:read-only { background: #F4EFE7; color: #7B6E62; }
QLineEdit::placeholder { color: #A89C8E; }

QComboBox::drop-down { border: none; width: 28px; }
QComboBox::down-arrow { image: url(:/icons/chevron_down_dark.png); width: 14px; height: 14px; }
QComboBox QAbstractItemView {
    background: #FFFFFF;
    border: 1px solid #DCCFBF;
    border-radius: 8px;
    padding: 4px;
    outline: 0;
    selection-background-color: #FBE9CC;
    selection-color: #2A211A;
}

QSpinBox::up-button, QSpinBox::down-button { width: 26px; border: none; background: transparent; }
QSpinBox::up-arrow   { image: url(:/icons/chevron_up_dark.png);   width: 12px; height: 12px; }
QSpinBox::down-arrow { image: url(:/icons/chevron_down_dark.png); width: 12px; height: 12px; }

QCheckBox { spacing: 8px; color: #4A3D31; }
QCheckBox::indicator { width: 18px; height: 18px; border: 1px solid #CDBBA3; border-radius: 5px; background: #FFFFFF; }
QCheckBox::indicator:checked { background: #B06A10; border-color: #B06A10; }

/* ---------------------------------------------------------------- tables */
QTableWidget {
    background: #FFFFFF;
    alternate-background-color: #FBF8F3;
    border: none;
    outline: 0;
    gridline-color: transparent;
}
QTableWidget::item { padding: 0 10px; border: none; }
QTableWidget::item:selected { background: #FBE9CC; color: #2A211A; }
QHeaderView { background: transparent; }
QHeaderView::section {
    background: #F7F2EA;
    color: #7B6E62;
    border: none;
    border-bottom: 1px solid #ECE3D6;
    padding: 11px 10px;
    font-weight: 700;
    font-size: 9pt;
}
QTableCornerButton::section { background: #F7F2EA; border: none; }

/* ------------------------------------------------------------- scrollbars */
QScrollBar:vertical { background: transparent; width: 12px; margin: 2px; }
QScrollBar::handle:vertical { background: #D9CDBE; border-radius: 4px; min-height: 36px; }
QScrollBar::handle:vertical:hover { background: #C4B3A0; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical { background: transparent; }
QScrollBar:horizontal { background: transparent; height: 12px; margin: 2px; }
QScrollBar::handle:horizontal { background: #D9CDBE; border-radius: 4px; min-width: 36px; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal { background: transparent; }

/* ---------------------------------------------------------- message boxes */
QMessageBox { background: #FFFFFF; }
QMessageBox QLabel { color: #2A211A; font-size: 10.5pt; }
QMessageBox QPushButton { min-width: 84px; }
QInputDialog { background: #FFFFFF; }

/* ----------------------------------------------------------------- toast */
#toast { border-radius: 12px; border: none; }
#toast[kind="success"] { background: #1F8A5B; }
#toast[kind="error"]   { background: #C0392B; }
#toast[kind="info"]    { background: #2F6DB5; }
#toast QLabel, #toastText { color: #FFFFFF; font-weight: 600; background: transparent; }
